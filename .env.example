# Growing Minds Tutoring environment variables
# Copy to .env.local for local development. All are OPTIONAL for local work:
# without them the enquiry form still validates and runs, logging instead of
# sending email and skipping the Turnstile check.

# --- Resend (transactional email) ---
# Get an API key at https://resend.com. Domain must be verified to send from it.
# Required in Vercel: without it the live form tells parents to email instead.
RESEND_API_KEY=
# Where enquiry notifications are delivered (defaults to the site email).
CONTACT_TO_EMAIL=hello@growingmindstutoring.co
# Verified "from" address (defaults to the site email). The domain
# (growingmindstutoring.co) must be verified in Resend before it can send.
RESEND_FROM="Growing Minds Tutoring <hello@growingmindstutoring.co>"

# --- Cloudflare Turnstile (spam protection) ---
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sanity (CMS for the Insights notes) ---
# Create a project at https://sanity.io/manage. Until these are set, the four
# insight notes render from content/insight-bodies.ts. Once set, published notes
# in Sanity take over automatically. Run the editing Studio with `npm run studio`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
